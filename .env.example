# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# Secret used to pseudonymise patient IDs: HMAC-SHA256(salt, synthea uuid).
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
PATIENT_ID_SALT=change-me

# --- Later phases (not used in Phase 1) ---
# Small tier: any OpenAI-compatible endpoint (hosted, or Ollama at http://localhost:11434/v1)
SMALL_BASE_URL=
SMALL_API_KEY=

# Large tier and evaluation judge: OpenAI-compatible endpoint by default
LARGE_PROVIDER=openai_compatible   # or: azure
LARGE_BASE_URL=
LARGE_API_KEY=

# Only when LARGE_PROVIDER=azure
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_DEPLOYMENT=
